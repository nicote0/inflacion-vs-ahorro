# Postgres local (docker compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# URL directa de Neon (sin "-pooler" en el host; el pipeline usa un advisory lock de sesión),
# con sslmode=verify-full
DATABASE_URL=
# Base de tests: postgres://USER:PASS@localhost:5432/<POSTGRES_DB>_test
TEST_DATABASE_URL=
# API: URL de Neon con "-pooler" en el host (si falta, usa DATABASE_URL)
DATABASE_URL_POOLED=
# API: orígenes permitidos por CORS, separados por coma (localhost siempre está permitido)
CORS_ORIGENES=
